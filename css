* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f1f8;
    color: #292333;
    line-height: 1.6;
}

header {
    background-color: #6c4a8e;
    color: white;
    text-align: center;
    padding: 50px 20px;
}

header h1 {
    font-size: 40px;
    margin-bottom: 10px;
}

nav {
    background-color: #39264d;
    text-align: center;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

main {
    max-width: 1000px;
    margin: 30px auto;
    padding: 0 20px;
}

section {
    background-color: white;
    padding: 30px;
    margin-bottom: 25px;
    border-radius: 10px;
}

h2 {
    color: #6c4a8e;
    margin-bottom: 15px;
}

.cards {
    display: flex;
    gap: 20px;
    margin-top: 20px;
}

article {
    flex: 1;
    background-color: #eee6f5;
    padding: 20px;
    border-radius: 8px;
}

article h3 {
    color: #39264d;
    margin-bottom: 10px;
}

footer {
    background-color: #39264d;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
}

@media (max-width: 700px) {
    .cards {
        flex-direction: column;
    }

    header h1 {
        font-size: 30px;
    }
}